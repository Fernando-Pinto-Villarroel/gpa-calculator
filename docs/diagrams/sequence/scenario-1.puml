@startuml scenario-1
skinparam monochrome true
skinparam shadowing false

actor Student
participant "GPA Calculator" as App
participant "localStorage" as Store

Student -> App : Opens app
App -> Store : Load selected career, cohort and saved grades
Store --> App : Return saved state
alt Commercial Software Engineering
  App -> App : calculateGpa(grades, terms)\n(credit-weighted)
  App --> Student : Cumulative GPA, academic standing\n(honors, SAP) and rate of progress
else ESP certificate
  App -> App : calculateGpa(grades, placement-level terms)\n(equal weight per course and lab)
  App --> Student : ESP cumulative GPA, completed courses,\nlabs and starting level
end
@enduml
